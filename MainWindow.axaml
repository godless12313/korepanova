<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab_1_avalonia.MainWindow"
        Title="Физический калькулятор — Задачи 3 и 12"
        Width="420" Height="400"
        CanResize="False">

  <StackPanel Margin="20" Spacing="8">

    <TextBlock Text="Задача 3: Гидравлический пресс (F₂ = F₁·S₂/S₁)"
               FontWeight="Bold" FontSize="13"/>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Сила F₁ (Н):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_F1" Width="100"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Площадь S₁ (м²):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_S1" Width="100"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Площадь S₂ (м²):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_S2" Width="100"/>
    </StackPanel>

    <Button x:Name="btn_Calc3" Content="Рассчитать F₂"
            Width="150" HorizontalAlignment="Left"/>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Результат F₂ (Н):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_Res3" Width="100" IsReadOnly="True" Background="#FFFFF0"/>
    </StackPanel>

    <Separator Margin="0,8"/>

    <TextBlock Text="Задача 12: Архимедова сила (Fа = ρ·g·a³)"
               FontWeight="Bold" FontSize="13"/>

    <TextBlock Text="ρ воды = 1000 кг/м³,  g = 10 м/с²"
               FontSize="10" Foreground="Gray"/>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Ребро кубика a (см):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_a" Width="100"/>
    </StackPanel>

    <Button x:Name="btn_Calc12" Content="Рассчитать Fа"
            Width="150" HorizontalAlignment="Left"/>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Архимедова сила (Н):" Width="140" VerticalAlignment="Center"/>
      <TextBox x:Name="txt_Res12" Width="100" IsReadOnly="True" Background="#FFFFF0"/>
    </StackPanel>

    <TextBlock x:Name="txt_Error" Foreground="Red" TextWrapping="Wrap"/>

  </StackPanel>
</Window>